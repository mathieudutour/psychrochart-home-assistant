{
  "name": "psychrochart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "esbuild dev/preview.ts --bundle --sourcemap --outfile=dev/preview.js --servedir=dev --watch",
    "build": "esbuild src/psychro-chart-card.tsx --bundle --outfile=out.js --minify",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --outdir=.test-build --log-level=warning && node --test .test-build/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "custom-card-helpers": "^1.9.0",
    "esbuild": "^0.19.11",
    "home-assistant-js-websocket": "^6.1.1",
    "preact": "^10.19.3",
    "typescript": "^5"
  }
}
